#!/usr/bin/env bash
# Avant tout push : recontrôle de tous les fichiers suivis, puis tests.
set -e
cd "$(git rev-parse --show-toplevel)"
python3 scripts/check_staged.py --all
if [ -x ".venv/bin/python" ]; then
  .venv/bin/python -m pytest tests/ -q
else
  echo "pre-push : .venv absent, tests non lancés (voir scripts/run_tests.sh)" >&2
  exit 1
fi
