# === Contenus qui ne doivent JAMAIS être publiés ===
# Normes sous copyright apportées par l'utilisateur, index et embeddings dérivés
corpus/private/*
!corpus/private/.gitkeep
!corpus/private/README.md
# Documents réels (clients, dossiers techniques non fictifs)
data/client/*
!data/client/.gitkeep
!data/client/README.md
# Index et bases vectorielles (peuvent contenir du texte privé)
data/index/
*.faiss
*.sqlite
*.db
chroma/
qdrant_storage/

# === Coordination multi-agent ===
.ai/LOCKDIR/
.ai/*.tmp

# === Secrets et configuration locale ===
.env
.env.*
!.env.example
*.local.yaml
secrets.yaml
secrets.yml
.claude/settings.local.json
.claude/worktrees/

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# === Modèles et artefacts volumineux ===
models/
*.gguf
*.safetensors
*.pt
*.bin
*.pkl
*.joblib

# === Résultats régénérables ===
results/*
!results/.gitkeep
# Exception : campagnes de mesure datées (rapport et sorties brutes), versionnées
# sur demande de l'utilisateur car une mesure sur GPU loué n'est pas gratuite à refaire.
!results/[0-9]*/
results/[0-9]*/*.pdf
results/[0-9]*/*.aux
results/[0-9]*/*.out
results/[0-9]*/*.toc
results/[0-9]*/*.fls
results/[0-9]*/*.fdb_latexmk
*.log

# === IDE / OS ===
.vscode/*
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# Tables de masquage (contiennent les termes d'origine)
*.masking.json
